[Unit]
Description=Open TV kiosk
After=systemd-user-sessions.service plymouth-quit-wait.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=opentv
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=OPEN_TV_DIR=/opt/open-tv
ExecStart=/opt/open-tv/scripts/kiosk.sh
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
